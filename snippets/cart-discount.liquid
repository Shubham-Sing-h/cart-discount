<input type="text" id="couponInput">
<button id="applyCoupon">Apply</button>

<script>
  document.addEventListener('DOMContentLoaded',function(){
    document.querySelector('#applyCoupon').addEventListener('click',function(){
      const discountCode = document.querySelector('#couponInput').value.trim();
      const formData = new FormData();
      formData.append('discount',discountCode);
      fetch('/cart/update.js',
        {
          method: "POST",
          body: formData
        }
      )
      .then(response=>response.json())
      .then(async (rest)=>{
        const response = await fetch('/cart?section_id=cart-drawer');
        try{
        const html = await response.text();
        const newHtml = new DOMParser().parseFromString(html,'text/html');
        const updatedCart = newHtml.querySelector('#CartDrawer');
        document.querySelector('#CartDrawer').innerHTML = updatedCart.innerHTML;
        }
        catch(error){
          console.log("error aa rhi hai=> ",error);
        }
      })
      .catch(error=>console.log(error))
    })
  })
</script>