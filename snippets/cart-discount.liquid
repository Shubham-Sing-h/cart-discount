<input type="text" id="couponInput">
<button id="couponApply">Apply</button>
<script>
  document.addEventListener('DOMContentLoaded',function(){
    document.querySelector('#couponApply').addEventListener('click',()=>{
      const couponInput = document.querySelector('#couponInput').value.trim();
      const formData = new FormData();
      formData.append('discount',couponInput);
      fetch('/cart/update.js',{
        method: "POST",
        body: formData
      })
      .then(response=>response.json())
      .then((data)=>{
        fetch('?section_id=cart-drawer')
          .then(r=>r.text())
          .then((html)=>{
            const newHtml = new DOMParser().parseFromString(html, 'text/html');
            const updatedCart = newHtml.querySelector('#CartDrawer');
            document.querySelector('#CartDrawer').innerHTML = updatedCart.innerHTML;
          })
          .catch(e=>console.log(e))
      })
      .catch((err)=>{console.log(err);})
    })
  })
</script>